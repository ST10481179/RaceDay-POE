@model IEnumerable<RaceDay.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

<p>
    @if (User.IsInRole("Organiser") || User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-action="Create">Create New Event</a>
    }
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Date</th>
            <th>Location</th>
            <th>Distance (km)</th>
            <th>Type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Date.ToString("yyyy-MM-dd")</td>
            <td>@item.Location</td>
            <td>@item.DistanceKm</td>
            <td>@item.Type</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (User.IsInRole("Organiser") && item.OrganiserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value || User.IsInRole("Admin"))
                {
                    <text> | <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></text>
                }
            </td>
        </tr>
    }
    </tbody>
</table>