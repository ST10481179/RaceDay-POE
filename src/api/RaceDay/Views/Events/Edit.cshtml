@model RaceDay.Models.Event
@{ ViewData["Title"] = "Edit event"; }

<h1 class="h3">Edit event</h1>
<hr />
<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_EventForm" model="Model" />

            <div class="mb-3">
                <label for="bannerFile" class="form-label">Banner Image</label>
                <input type="file" id="bannerFile" name="bannerFile" class="form-control"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                <div class="form-text">Choose a file to replace the current banner. Check the box below to remove it.</div>
                @Html.ValidationMessage("bannerFile", "", new { @class = "text-danger" })
            </div>

            @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
            {
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="removeBanner" name="removeBanner" value="true" />
                    <label class="form-check-label" for="removeBanner">Remove current banner</label>
                </div>
                <img src="@Model.BannerImageUrl" alt="Banner for @Model.Name" class="img-fluid rounded mb-3"
                     style="max-height:320px;object-fit:cover" />
            }

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
