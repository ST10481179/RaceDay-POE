@model IEnumerable<RaceDay.Models.Result>

@{
    ViewData["Title"] = "My Results";
}

<h1>My Results</h1>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Category</th>
            <th>Finish Time</th>
            <th>Position</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Event?.Name</td>
            <td>@(item.Event?.Date.ToString("dd MMM yyyy") ?? "-")</td>
            <td>—</td>
            <td>@(item.FinishTime?.ToString("hh\\:mm\\:ss") ?? "Pending")</td>
            <td>@(item.Position.HasValue ? item.Position.Value.ToString() : "Pending")</td>
        </tr>
    }
    </tbody>
</table>
