@model IEnumerable<RaceDay.Models.Enrolment>

@{
    ViewData["Title"] = "My Enrolments";
}

<h1>My Enrolments</h1>

<table class="table">
    <thead>
        <tr>
            <th>Event</th>
            <th>Category</th>
            <th>Enrolled At</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Event?.Name</td>
            <td>@item.Category?.Name</td>
            <td>@item.EnrolledAt.ToString("yyyy-MM-dd HH:mm")</td>
        </tr>
    }
    </tbody>
</table>