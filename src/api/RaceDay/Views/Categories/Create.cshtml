@model RaceDay.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<h1>Create Category</h1>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="EventId" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="MaxAge" class="form-label"></label>
        <input asp-for="MaxAge" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="MinDistanceKm" class="form-label"></label>
        <input asp-for="MinDistanceKm" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="MaxDistanceKm" class="form-label"></label>
        <input asp-for="MaxDistanceKm" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>