using Microsoft.AspNetCore.Identity;
using Microsoft.EntityFrameworkCore;
using Microsoft.OpenApi;
using RaceDay;
using RaceDay.Data;
using RaceDay.Models.Interface;

using var scope = builder.Services.BuildServiceProvider().CreateScope();
var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
db.Database.Migrate();

using (var appScope = builder.Services.BuildServiceProvider().CreateScope())
{
    await SeedAdmin.EnsureAdminUserAsync(appScope.ServiceProvider);
}

using (var scope2 = builder.Services.BuildServiceProvider().CreateScope())
{
    var context = scope2.ServiceProvider.GetRequiredService<ApplicationDbContext>();
    context.Database.Migrate();
}

using (var adminScope = builder.Services.BuildServiceProvider().CreateScope())
{
    await SeedAdmin.EnsureAdminUserAsync(adminScope.ServiceProvider);
}

var app = builder.Build();

using (var scope3 = app.Services.CreateScope())
{
    var db3 = scope3.ServiceProvider.GetRequiredService<ApplicationDbContext>();
    db3.Database.Migrate();
    await SeedAdmin.EnsureAdminUserAsync(scope3.ServiceProvider);
}


var builder = WebApplication.CreateBuilder(args);

// Connection string
var connectionString = builder.Configuration.GetConnectionString("DefaultConnection")
    ?? throw new InvalidOperationException("Connection string 'DefaultConnection' not found.");

// Database + Identity
builder.Services.AddDbContext<ApplicationDbContext>(options =>
    options.UseSqlServer(connectionString));

builder.Services.AddDatabaseDeveloperPageExceptionFilter();

builder.Services.AddDefaultIdentity<ApplicationUser>(options => options.SignIn.RequireConfirmedAccount = true)
    .AddRoles<IdentityRole>()
    .AddEntityFrameworkStores<ApplicationDbContext>();

builder.Services.AddControllersWithViews();
builder.Services.AddScoped<IProfileImageService, ProfileImageService>();
builder.Services.AddSingleton<RaceDay.Services.IBlobStorageService, RaceDay.Services.BlobStorageService>();

// Swagger services
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen(c =>
{
    c.SwaggerDoc("v1", new OpenApiInfo
    {
        Title = "RaceDay API",
        Version = "v1",
        Description = "API for managing RaceDay events, authentication, and participants"
    });
});

var app = builder.Build();

using (var scope = app.Services.CreateScope())
{
    var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
    db.Database.Migrate();
}

// Swagger middleware
if (app.Environment.IsDevelopment())
{
    app.UseSwagger();
    app.UseSwaggerUI(c =>
    {
        c.SwaggerEndpoint("/swagger/v1/swagger.json", "RaceDay API v1");
        c.RoutePrefix = "swagger";
    });

    app.UseMigrationsEndPoint();
}
else
{
    app.UseExceptionHandler("/Home/Error");
    app.UseHsts();
}

app.UseHttpsRedirection();
app.UseStaticFiles();
app.UseRouting();

app.UseAuthentication();
app.UseAuthorization();

app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Home}/{action=Index}/{id?}");

app.MapRazorPages();

app.Run();
