@model IEnumerable<RaceDay.Models.Event>
@{
    ViewData["Title"] = "Home";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold">Upcoming RaceDay events</h1>
    <p class="text-muted">Find your next challenge and get enrolled before registration closes.</p>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No upcoming events have been published yet.</div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="event-card h-100">
                    @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name banner" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light" style="height:190px;">
                            <span class="text-muted">No banner</span>
                        </div>
                    }
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary rounded-pill">@ev.EventType</span>
                            <span class="text-muted small">@ev.Date.ToString("dd MMM yyyy")</span>
                        </div>
                        <h5 class="mb-2">@ev.Name</h5>
                        <p class="text-muted small mb-2">@ev.Location</p>
                        <p class="mb-3">@ev.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@ev.DistanceKm.ToString("0.##") km</strong>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary">View details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
